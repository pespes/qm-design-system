{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "typecheck": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsc --noEmit -p {projectRoot}/tsconfig.lib.json"
      }
    },
    "test": {
      "cache": true,
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "{projectRoot}/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    }
  },
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    }
  ]
}
