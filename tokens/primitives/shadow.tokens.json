{
  "shadow": {
    "$description": "Elevation shadows using oklch with rgba fallbacks",
    "$type": "shadow",
    "0": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "oklch(0% 0 0 / 0)"
        }
      ],
      "$description": "No shadow — for explicitly removing elevation"
    },
    "100": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "oklch(0% 0 0 / 0.05)"
        }
      ],
      "$description": "Subtle lift — cards, buttons at rest",
      "$extensions": {
        "rgba-fallback": ["0px 1px 2px 0px rgba(0,0,0,0.05)"]
      }
    },
    "200": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px",
          "color": "oklch(0% 0 0 / 0.1)"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "-1px",
          "color": "oklch(0% 0 0 / 0.06)"
        }
      ],
      "$description": "Low elevation — hovering cards, raised sections",
      "$extensions": {
        "rgba-fallback": ["0px 1px 3px 0px rgba(0,0,0,0.1)", "0px 1px 2px -1px rgba(0,0,0,0.06)"]
      }
    },
    "300": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-1px",
          "color": "oklch(0% 0 0 / 0.1)"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px",
          "color": "oklch(0% 0 0 / 0.06)"
        }
      ],
      "$description": "Medium elevation — dropdowns, popovers",
      "$extensions": {
        "rgba-fallback": ["0px 4px 6px -1px rgba(0,0,0,0.1)", "0px 2px 4px -2px rgba(0,0,0,0.06)"]
      }
    },
    "400": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "15px",
          "spread": "-3px",
          "color": "oklch(0% 0 0 / 0.1)"
        },
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-4px",
          "color": "oklch(0% 0 0 / 0.05)"
        }
      ],
      "$description": "High elevation — modals, dialogs",
      "$extensions": {
        "rgba-fallback": ["0px 10px 15px -3px rgba(0,0,0,0.1)", "0px 4px 6px -4px rgba(0,0,0,0.05)"]
      }
    },
    "500": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "20px",
          "blur": "25px",
          "spread": "-5px",
          "color": "oklch(0% 0 0 / 0.1)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "10px",
          "spread": "-6px",
          "color": "oklch(0% 0 0 / 0.04)"
        }
      ],
      "$description": "Highest elevation — toasts, command palettes",
      "$extensions": {
        "rgba-fallback": ["0px 20px 25px -5px rgba(0,0,0,0.1)", "0px 8px 10px -6px rgba(0,0,0,0.04)"]
      }
    }
  }
}
