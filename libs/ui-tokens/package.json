{
  "name": "@pespes/ui-tokens",
  "version": "1.0.4",
  "description": "Quartermaster design tokens — DTCG source, CSS custom properties, and React Native TwTheme objects",
  "author": {
    "name": "Quartermaster",
    "url": "https://quartermaster.house"
  },
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "quartermaster",
    "typescript",
    "ui"
  ],
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">= 22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./css/tokens": "./dist/css/tokens.css",
    "./css/tokens-pro": "./dist/css/tokens.pro.css",
    "./native/tokens": "./dist/native/native.ts",
    "./native/tokens-pro": "./dist/native/native.pro.ts",
    "./json/token-keys": "./dist/json/tokenKeys.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:tokens": "pnpm tsc --build && node build/src/dictionary-config.js",
    "build": "pnpm run clean && pnpm run build:tokens"
  },
  "dependencies": {
    "style-dictionary": "^5.4.0"
  },
  "devDependencies": {
    "@nx/jest": "^22.7.0",
    "@nx/workspace": "^22.7.0",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "bignumber.js": "^11.0.0",
    "jest": "^30.3.0",
    "lodash-es": "^4.18.1",
    "vitest": "^2.1.5"
  }
}
