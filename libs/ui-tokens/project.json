{
  "name": "ui-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-tokens/src",
  "projectType": "library",
  "tags": ["scope:shared"],
  "targets": {
    "typecheck": {},
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm jest --config=jest.config.ts",
          "pnpm vitest run --config=vitest.config.ts"
        ],
        "parallel": false,
        "cwd": "libs/ui-tokens"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "./eslint.config.mjs",
        "lintFilePatterns": [
          "libs/ui-tokens/src/**/*.ts",
          "libs/ui-tokens/src/**/*.tsx"
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "libs/ui-tokens"
      },
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/build"
      ]
    }
  }
}
