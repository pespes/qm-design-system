{
  "fontFamily": {
    "$description": "Font family strings",
    "$type": "fontFamily",
    "sans": {
      "$value": ["DM Sans", "Helvetica Neue", "Arial", "sans-serif"]
    }
  },
  "fontWeight": {
    "$description": "Font weights mapping to the standard CSS 100-scale",
    "$type": "fontWeight",
    "400": { "$value": 400, "$description": "Regular" },
    "500": { "$value": 500, "$description": "Medium" },
    "600": { "$value": 600, "$description": "Semibold" },
    "700": { "$value": 700, "$description": "Bold" }
  },
  "fontSize": {
    "$description": "Font sizes stored as raw pixel equivalents",
    "$type": "dimension",
    "025":  { "$value": 11 },
    "050":  { "$value": 12 },
    "075":  { "$value": 14 },
    "100":  { "$value": 16 },
    "200":  { "$value": 18 },
    "300":  { "$value": 20 },
    "400":  { "$value": 24 },
    "500":  { "$value": 28 },
    "600":  { "$value": 32 },
    "700":  { "$value": 36 },
    "800":  { "$value": 40 },
    "900":  { "$value": 48 },
    "1000": { "$value": 60 }
  },
  "lineHeight": {
    "$description": "Line heights using a unitless multiplier scale (e.g., 125 = 1.25x)",
    "$type": "number",
    "125": { "$value": 1.25 },
    "150": { "$value": 1.5 }
  },
  "letterSpacing": {
    "$description": "Tracking values stored as base-1000 integers. Divide by 1000 for 'em' output.",
    "$type": "number",

    "n050": {
      "$value": -50,
      "$description": "-0.05em (Tailwind 'tighter')"
    },
    "n025": {
      "$value": -25,
      "$description": "-0.025em (Tailwind 'tight')"
    },
    "000": {
      "$value": 0,
      "$description": "0em (Tailwind 'normal')"
    },
    "025": {
      "$value": 25,
      "$description": "0.025em (Tailwind 'wide')"
    },
    "050": {
      "$value": 50,
      "$description": "0.05em (Tailwind 'wider')"
    },
    "100": {
      "$value": 100,
      "$description": "0.1em (Tailwind 'widest')"
    }
  }
}
