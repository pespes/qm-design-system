{
  "color":{
    "surface": {
      "$description": "Background colors for layered UI surfaces",

      "page": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Page/body background"
      },
      "default": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Default card/container background"
      },
      "raised": {
        "$type": "color",
        "$value": "{color.grey.050}",
        "$description": "Raised surface (nested cards, table headers, sidebar bg)"
      },
      "sunken": {
        "$type": "color",
        "$value": "{color.grey.100}",
        "$description": "Recessed surface (input wells, code blocks)"
      },
      "overlay": {
        "$type": "color",
        "$value": "{color.grey.900}",
        "$description": "Backdrop behind modals/drawers. Pair with opacity.400 for scrim."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.grey.950}",
        "$description": "Inverted surface (tooltips, toasts)"
      }
    },

    "foreground": {
      "$description": "Foreground / text colors",

      "default": {
        "$type": "color",
        "$value": "{color.grey.900}",
        "$description": "Primary body text"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.grey.500}",
        "$description": "Secondary text, labels, captions"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.grey.400}",
        "$description": "Placeholder text, disabled labels"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text on inverse/dark surfaces"
      }
    },

    "border": {
      "$description": "Border and divider colors",

      "default": {
        "$type": "color",
        "$value": "{color.grey.200}",
        "$description": "Standard structural borders (cards, dividers, table rows)"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.grey.400}",
        "$description": "Higher-contrast borders (hovered inputs, emphasized dividers)"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.grey.100}",
        "$description": "Low-contrast separators (within cards, between list items)"
      }
    },
    "primary": {
      "$description": "Default interactive color — grey. Used for standard buttons, toggles, active states.",

      "background": {
        "$type": "color",
        "$value": "{color.grey.900}",
        "$description": "Primary solid fill (default buttons). Use state.hover-on-dark / pressed-on-dark for states."
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text on primary.background"
      },
      "background-subtle": {
        "$type": "color",
        "$value": "{color.grey.100}",
        "$description": "Subtle primary surface (toggle bg, selected table row)"
      },
      "text": {
        "$type": "color",
        "$value": "{color.grey.900}",
        "$description": "Primary-hued text/icons on light surfaces (active states, emphasis)"
      },
      "border": {
        "$type": "color",
        "$value": "{color.grey.300}",
        "$description": "Primary-weight border (outlined buttons at rest)"
      },
      "border-strong": {
        "$type": "color",
        "$value": "{color.grey.900}",
        "$description": "Strong primary border (high-emphasis outlined buttons)"
      }
    },
    "brand": {
      "$description": "Brand accent — Homeowner (green). Links, active states, brand moments.",

      "background": {
        "$type": "color",
        "$value": "{color.green.600}",
        "$description": "Brand solid fill. Use state.hover-on-dark / pressed-on-dark for states."
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text on brand.background"
      },
      "background-subtle": {
        "$type": "color",
        "$value": "{color.green.050}",
        "$description": "Brand tinted surface (active sidebar item, selected chip)"
      },
      "text": {
        "$type": "color",
        "$value": "{color.green.700}",
        "$description": "Brand-hued text and icons on light surfaces (links, active breadcrumbs)"
      },
      "border": {
        "$type": "color",
        "$value": "{color.green.200}",
        "$description": "Brand-tinted border (selected cards, active inputs)"
      },
      "border-strong": {
        "$type": "color",
        "$value": "{color.green.600}",
        "$description": "Strong brand border"
      }
    },
    "accent": {
      "$description": "Accent — violet. Tags, badges, actions, feature callouts.",

      "background": {
        "$type": "color",
        "$value": "{color.violet.600}",
        "$description": "Accent solid fill. Use state.hover-on-dark / pressed-on-dark for states."
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text on accent.background"
      },
      "background-subtle": {
        "$type": "color",
        "$value": "{color.violet.050}",
        "$description": "Accent tinted surface"
      },
      "text": {
        "$type": "color",
        "$value": "{color.violet.700}",
        "$description": "Accent-hued text and icons on light surfaces (tags, badges)"
      },
      "border": {
        "$type": "color",
        "$value": "{color.violet.200}",
        "$description": "Accent-tinted border"
      },
      "border-strong": {
        "$type": "color",
        "$value": "{color.violet.600}",
        "$description": "Strong accent border"
      }
    },
    "status": {
      "$description": "Semantic status colors. All pairings verified for WCAG AA.",
      "danger": {
        "$description": "Destructive actions, error states, and validation failures. Use background for destructive buttons and high-emphasis alerts; background-subtle for inline error messages and alert banners.",

        "background": {
          "$type": "color",
          "$value": "{color.red.600}",
          "$description": "Danger solid fill (destructive buttons, high-emphasis alerts)"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Text/icons on danger.background (6.85:1)"
        },
        "background-subtle": {
          "$type": "color",
          "$value": "{color.red.050}",
          "$description": "Danger tinted surface (banners, inline alerts)"
        },
        "text": {
          "$type": "color",
          "$value": "{color.red.700}",
          "$description": "Danger-hued text and icons on light surfaces (7.65:1 on red.050)"
        },
        "border": {
          "$type": "color",
          "$value": "{color.red.200}",
          "$description": "Danger border"
        },
        "border-strong": {
          "$type": "color",
          "$value": "{color.red.600}",
          "$description": "High-contrast danger border"
        }
      },
      "warning": {
        "$description": "Cautionary states that require attention but aren't failures. Use background for high-emphasis warning actions; background-subtle for advisory banners, rate limit notices, and non-blocking warnings.",
        "background": {
          "$type": "color",
          "$value": "{color.yellow.600}",
          "$description": "Warning solid fill (6.33:1 vs white)"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Text/icons on warning.background"
        },
        "background-subtle": {
          "$type": "color",
          "$value": "{color.yellow.050}",
          "$description": "Warning tinted surface (banners, inline alerts)"
        },
        "text": {
          "$type": "color",
          "$value": "{color.yellow.700}",
          "$description": "Warning-hued text and icons on light surfaces (7.34:1 on yellow.050)"
        },
        "border": {
          "$type": "color",
          "$value": "{color.yellow.200}",
          "$description": "Warning border"
        },
        "border-strong": {
          "$type": "color",
          "$value": "{color.yellow.600}",
          "$description": "High-contrast warning border"
        }
      },
      "success": {
        "$description": "Confirmation, completion, and positive feedback states. Use background for success actions and high-emphasis confirmations; background-subtle for success toasts, completion banners, and inline validation.",
        "background": {
          "$type": "color",
          "$value": "{color.green.500}",
          "$description": "Success solid fill (4.18:1 vs white). Uses green.500 rather than green.600 to differentiate from brand.background in the Homeowner theme."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Text/icons on success.background"
        },
        "background-subtle": {
          "$type": "color",
          "$value": "{color.green.050}",
          "$description": "Success tinted surface (banners, confirmation states)"
        },
        "text": {
          "$type": "color",
          "$value": "{color.green.700}",
          "$description": "Success-hued text and icons on light surfaces (6.74:1 on green.050)"
        },
        "border": {
          "$type": "color",
          "$value": "{color.green.200}",
          "$description": "Success border"
        },
        "border-strong": {
          "$type": "color",
          "$value": "{color.green.500}",
          "$description": "High-contrast success border"
        }
      },
      "info": {
        "$description": "Informational status.",
        "background": {
          "$type": "color",
          "$value": "{color.blue.600}",
          "$description": "Info solid fill (6.47:1 vs white)"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Text/icons on info.background"
        },
        "background-subtle": {
          "$type": "color",
          "$value": "{color.blue.050}",
          "$description": "Info tinted surface (banners, informational callouts)"
        },
        "text": {
          "$type": "color",
          "$value": "{color.blue.700}",
          "$description": "Info-hued text and icons on light surfaces (7.42:1 on blue.050)"
        },
        "border": {
          "$type": "color",
          "$value": "{color.blue.200}",
          "$description": "Info border"
        },
        "border-strong": {
          "$type": "color",
          "$value": "{color.blue.600}",
          "$description": "High-contrast info border"
        }
      }
    },
    "state": {
      "$description": "Semi-transparent overlays for interactive states. Applied via pseudo-elements.",
      "hover-on-light": {
        "$type": "color",
        "$value": "oklch(0% 0 0 / 0.08)",
        "$description": "Hover overlay for light surfaces",
        "$extensions": {
          "rgba-fallback": "rgba(0, 0, 0, 0.08)"
        }
      },
      "pressed-on-light": {
        "$type": "color",
        "$value": "oklch(0% 0 0 / 0.16)",
        "$description": "Pressed/active overlay for light surfaces",
        "$extensions": {
          "rgba-fallback": "rgba(0, 0, 0, 0.16)"
        }
      },
      "hover-on-dark": {
        "$type": "color",
        "$value": "oklch(100% 0 0 / 0.12)",
        "$description": "Hover overlay for dark surfaces",
        "$extensions": {
          "rgba-fallback": "rgba(255, 255, 255, 0.12)"
        }
      },
      "pressed-on-dark": {
        "$type": "color",
        "$value": "oklch(100% 0 0 / 0.24)",
        "$description": "Pressed/active overlay for dark surfaces",
        "$extensions": {
          "rgba-fallback": "rgba(255, 255, 255, 0.24)"
        }
      },
      "disabled": {
        "$type": "color",
        "$value": "oklch(0% 0 0 / 0.38)",
        "$description": "Applied to dark content to indicate disabled",
        "$extensions": {
          "rgba-fallback": "rgba(0, 0, 0, 0.38)"
        }
      },
      "disabled-subtle": {
        "$type": "color",
        "$value": "oklch(0% 0 0 / 0.6)",
        "$description": "Applied to light content to indicate disabled",
        "$extensions": {
          "rgba-fallback": "rgba(0, 0, 0, 0.6)"
        }
      },
      "dragged": {
        "$type": "color",
        "$value": "oklch(0% 0 0 / 0.12)",
        "$description": "Drag state overlay",
        "$extensions": { 
          "rgba-fallback": "rgba(0, 0, 0, 0.12)"
        }
      }
    },
    "focus": {
      "$description": "Focus ring and offset colors",
      "ring": {
        "$type": "color",
        "$value": "{color.primary.border-strong}",
        "$description": "Focus ring color."
      },
      "offset": {
        "$type": "color",
        "$value": "{color.border.subtle}",
        "$description": "Gap between element and focus ring for contrast separation"
      }
    }
  }
}
